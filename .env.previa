# Carregado por `npm run build:previa` (vite build --mode previa): o SITE DE TESTE que a
# Vercel publica na prévia de cada PR (ver vercel.json). Sem Firebase, sem login: abre
# direto numa conta de mentira, e nada do que se faz ali encosta em conta de verdade.
VITE_PERSISTENCE=memory
# Liga o que só o site publicado tem: os dados ficam no navegador (não só na aba) e a
# etiqueta "site de teste" fica na tela. O `dev:teste` e o e2e não ligam isto.
VITE_TEST_SITE=1
