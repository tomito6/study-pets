{
  "name": "study-pets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Timer de foco com RPG — planejamento diário adaptável, XP, moedas e pets.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "vite build --mode native",
    "build:previa": "vite build --mode previa",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:teste": "vite --mode teste --port 5174",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ext": "playwright test -c playwright.extension.config.ts",
    "ios:sync": "npm run build:native && cap sync ios",
    "ios:open": "cap open ios",
    "test:desktop": "playwright test -c playwright.desktop.config.ts",
    "desktop:install": "npm --prefix desktop install",
    "desktop": "npm run build:native && npm --prefix desktop start",
    "desktop:dist": "npm run build:native && npm --prefix desktop run dist"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "firebase": "^10.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
